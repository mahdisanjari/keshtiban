# ─── کشتی‌بان — تنظیمات قابل‌ویرایش ───────────────────────────────
# این فایل را به .env.local کپی کنید و مقادیر واقعی را وارد کنید.
# متغیرهای NEXT_PUBLIC_* هنگام build داخل کد قرار می‌گیرند.

# آدرس نهایی سایت (برای canonical، sitemap و Open Graph) — بدون اسلش پایانی
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ایمیل شرکت (برای دکمه ایمیل و Schema.org)
NEXT_PUBLIC_CONTACT_EMAIL=

# شماره واتس‌اپ به فرمت بین‌المللی، فقط ارقام و بدون + یا صفر ابتدایی (مثال ساختاری: 98912xxxxxxx)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# شماره تلفن نمایشی (اختیاری) — مثلاً +98 21 0000 0000
NEXT_PUBLIC_CONTACT_PHONE=

# نشانی شرکت (اختیاری)
NEXT_PUBLIC_CONTACT_ADDRESS=

# ─── اتصال فرم استعلام (سمت سرور، عمومی نیست) ───
# آدرس یک webhook (مثلاً n8n، Zapier، Make، یا endpoint ایمیل خودتان) که درخواست‌ها را
# به‌صورت JSON با متد POST دریافت می‌کند. تا زمانی که تنظیم نشود، فرم «ارسال موفق» نشان نمی‌دهد.
INQUIRY_WEBHOOK_URL=
# توکن اختیاری که به‌صورت Authorization: Bearer ارسال می‌شود
INQUIRY_WEBHOOK_TOKEN=
